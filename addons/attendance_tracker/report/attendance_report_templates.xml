<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_attendance_summary">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <h2>Attendance Summary</h2>
                    <p t-if="date_from">
                        Period: <strong><t t-esc="date_from"/></strong>
                        to <strong><t t-esc="date_to"/></strong>
                    </p>

                    <h4>Summary by employee (ranked by hours)</h4>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Employee</th>
                                <th class="text-end">Days present</th>
                                <th class="text-end">Total hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="summary" t-as="s">
                                <tr>
                                    <td><t t-esc="s_index + 1"/></td>
                                    <td><t t-esc="s['employee'].name"/></td>
                                    <td class="text-end"><t t-esc="s['days']"/></td>
                                    <td class="text-end"><t t-esc="'%.2f' % s['hours']"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Grand total</th>
                                <th class="text-end"><t t-esc="'%.2f' % total_hours"/></th>
                            </tr>
                        </tfoot>
                    </table>

                    <h4>Details</h4>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Employee</th>
                                <th>Date</th>
                                <th>Check-in</th>
                                <th>Check-out</th>
                                <th class="text-end">Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="line">
                                <tr>
                                    <td><span t-field="line.name"/></td>
                                    <td><span t-field="line.employee_id"/></td>
                                    <td><span t-field="line.date"/></td>
                                    <td><span t-field="line.check_in"/></td>
                                    <td><span t-field="line.check_out"/></td>
                                    <td class="text-end">
                                        <span t-field="line.worked_hours"
                                              t-options='{"widget": "float_time"}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
