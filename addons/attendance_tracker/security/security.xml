<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Category: groups the two groups under one heading in user settings -->
    <record id="module_category_attendance_tracker" model="ir.module.category">
        <field name="name">Attendance Tracker</field>
        <field name="sequence">50</field>
    </record>

    <!-- 2. Groups -->
    <record id="group_attendance_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_attendance_tracker"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_attendance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_attendance_tracker"/>
        <field name="implied_ids" eval="[(4, ref('group_attendance_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- 3. Record rules (row-level security) -->
    <record id="rule_attendance_record_user_own" model="ir.rule">
        <field name="name">Attendance: users see only their own records</field>
        <field name="model_id" ref="model_attendance_record"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_attendance_user'))]"/>
    </record>

    <record id="rule_attendance_record_manager_all" model="ir.rule">
        <field name="name">Attendance: managers see all records</field>
        <field name="model_id" ref="model_attendance_record"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_attendance_manager'))]"/>
    </record>

    <!-- Global rule (no group): multi-company isolation -->
    <record id="rule_attendance_record_company" model="ir.rule">
        <field name="name">Attendance: multi-company</field>
        <field name="model_id" ref="model_attendance_record"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
