<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_attendance_record_form" model="ir.ui.view">
        <field name="name">attendance.record.form</field>
        <field name="model">attendance.record</field>
        <field name="arch" type="xml">
            <form string="Attendance Record">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'confirmed'"
                            groups="attendance_tracker.group_attendance_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state == 'confirmed'"/>
                            <field name="date" readonly="state == 'confirmed'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="check_in" readonly="state == 'confirmed'"/>
                            <field name="check_out" readonly="state == 'confirmed'"/>
                            <field name="worked_hours" widget="float_time"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..." readonly="state == 'confirmed'"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW (called "tree" in Odoo 17; renamed "list" in Odoo 18) -->
    <record id="view_attendance_record_tree" model="ir.ui.view">
        <field name="name">attendance.record.tree</field>
        <field name="model">attendance.record</field>
        <field name="arch" type="xml">
            <tree string="Attendance Records" decoration-success="state == 'confirmed'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time" sum="Total Hours"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_attendance_record_search" model="ir.ui.view">
        <field name="name">attendance.record.search</field>
        <field name="model">attendance.record</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="name"/>
                <field name="employee_id"/>
                <filter string="Today" name="today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Month" name="group_month"
                            context="{'group_by': 'date:month'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_attendance_record" model="ir.actions.act_window">
        <field name="name">Attendance Records</field>
        <field name="res_model">attendance.record</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first attendance record</p>
            <p>Record check-in and check-out times for your employees.</p>
        </field>
    </record>
</odoo>
